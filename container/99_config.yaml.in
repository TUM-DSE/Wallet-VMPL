network:
  version: 2
  renderer: networkd
  ethernets:
    adminif:
      match:
        driver: e1000
      addresses:
        - 192.168.8.10/24
        - 192.168.56.10/21
      routes:
        - to: default
          via: 192.168.8.1
      nameservers:
        addresses:
          - 131.159.254.1

