[libos]
entrypoint = "/lib/iomgr_trustlet"

[loader]
log_level = "debug"
entrypoint = "file:/gramine/python-libs/lib/x86_64-linux-gnu/gramine/libsysdb.so"
argv = ["iomgr_trustlet"]
loader.insecure__disable_aslr  = true

[loader.env]
LD_LIBRARY_PATH = "/lib"

[fs]
root.type = "tmpfs"
mounts = [
  { type = "pseudo", path = "/lib", uri = "lib" },
]

[sys]
# DPDK's fbarray (memzone/malloc heap bookkeeping) flock()s its backing files;
# without this the iperf VNFlet's EAL init fails with "Cannot allocate memzone list".
experimental__enable_flock = true
