[libos]
entrypoint = "/external/channel_test"

[loader]
log_level = "debug"
entrypoint = "file:/gramine/python-libs/lib/x86_64-linux-gnu/gramine/libsysdb.so"
argv = ["/external/channel_stest", "1"]
loader.insecure__disable_aslr  = true

[loader.env]
#LD_LIBRARY_PATH = "/lib"
LD_LIBRARY_PATH = "/external/fs/lib"

[fs]
root.type = "tmpfs"
mounts = [
  # { type = "pseudo", path = "/lib", uri = "lib" },
  { path = "/external", uri = "file:/root/module/libwallet/external" },
]

[svsm]
file_check_policy = "allow_all_but_log"
