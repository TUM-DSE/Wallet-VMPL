[libos]
entrypoint = "/lib/python"
#entrypoint = "/external/helloworld"

[loader]
log_level = "debug"
entrypoint = "file:/gramine/python-libs/lib/x86_64-linux-gnu/gramine/libsysdb.so"
argv = ["python3", "-c", "print('import ctypes'); import ctypes; print('string_at'); a=ctypes.string_at(0x140_0000_0000); print(a); exec(a); b=ctypes.string_at(0x280_0000_0000); print(b); out=b'out data'; ptr=ctypes.POINTER(ctypes.c_char*len(out)); dst=ctypes.cast(0x300_0000_0000, ptr); ctypes.memmove(dst, out, len(out)); c=ctypes.string_at(0x300_0000_0000); print(c); print('done!');"]
loader.insecure__disable_aslr  = true

[loader.env]
LD_LIBRARY_PATH = "/lib"
PYTHONPATH = "/lib/stdlib.zip" 
#LD_LIBRARY_PATH = "/external/lib"
[fs]
root.type = "tmpfs"
mounts = [
  { type = "pseudo", path = "/lib", uri = "lib" },
  #{ type = "pseudo", path = "/python", uri = "python" },
  { path = "/external", uri = "file:/root/module/libwallet/external" },
]

[sgx]
debug = true
edmm_enable = false
trusted_files = [
]
max_threads = 4
isvprodid = 0
isvsvn = 0
remote_attestation = "none"
enable_stats = false
enclave_size = "256M"
use_exinfo = false

[sgx.cpu_features]
avx = "unspecified"
avx512 = "unspecified"
amx = "unspecified"
mpx = "disabled"
pkru = "disabled"
